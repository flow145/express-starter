{
  "name": "express-starter",
  "description": "A minimal starter for Express backend with TypeScript",
  "version": "1.0.0-alpha.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "homepage": "https://github.com/flow145/express-starter#readme",
  "bugs": "https://github.com/flow145/express-starter/issues",
  "repository": "git@github.com:flow145/express-starter.git",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "APP_STAGE=prod node src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node src/db/seed.ts",
    "format": "biome format --reporter=summary",
    "format:fix": "pnpm format --write",
    "check": "biome check --reporter=summary",
    "check:fix": "pnpm check --write",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@epic-web/remember": "~1.1.0",
    "cookie-parser": "~1.4.7",
    "cors": "~2.8.6",
    "custom-env": "~2.0.6",
    "drizzle-orm": "~0.45.2",
    "express": "~5.2.1",
    "express-rate-limit": "~8.5.2",
    "helmet": "~8.2.0",
    "http-status-codes": "~2.3.0",
    "pg": "~8.21.0",
    "pino": "~10.3.1",
    "pino-http": "~11.0.0",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "~21.0.2",
    "@commitlint/config-conventional": "~21.0.2",
    "@types/cookie-parser": "~1.4.10",
    "@types/cors": "~2.8.19",
    "@types/express": "~5.0.6",
    "@types/node": "~24.12.4",
    "@types/pg": "~8.20.0",
    "drizzle-kit": "~0.31.10",
    "lefthook": "~2.1.9",
    "pino-pretty": "~13.1.3",
    "typescript": "~6.0.3"
  },
  "imports": {
    "#/*": "./src/*"
  }
}
